# ------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-anon-key>"

# Legacy JWT signing secret (Project Settings -> JWT Keys). OPTIONAL, and only
# needed by projects that still sign access tokens with the shared HS256
# secret. The mobile API verifies `Authorization: Bearer` tokens against the
# project's published public keys at
# <NEXT_PUBLIC_SUPABASE_URL>/auth/v1/.well-known/jwks.json, which needs nothing
# configured here and lets keys rotate without a deploy.
#
# Prefer migrating the project to asymmetric keys (Supabase dashboard ->
# Authentication -> JWT Keys -> "Migrate JWT secret") and leaving this empty:
# a value here is a key that can MINT tokens, not just check them, so it turns
# every server that holds it into something worth stealing.
SUPABASE_JWT_SECRET=""

# ------------------------------------------------------------------
# Database (Supabase → Connect → Connection string)
# DATABASE_URL: Transaction pooler (port 6543) for the Next.js runtime.
#               Must include ?pgbouncer=true. Use the IPv4 pooler host
#               (aws-0-… or aws-1-….pooler.supabase.com), not db.<ref>.supabase.co.
# DIRECT_URL:   Session pooler / direct (port 5432) for Prisma migrations.
# Vercel: set both for Production. Wrong host/port causes intermittent
#         {"status":"degraded","db":"down"} on /api/health.
# ------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------
# Performance tuning (optional — see PERFORMANCE.md)
# DB_POOL_MAX: pg connections per serverless isolate (default 5, sized for
#              Supabase Pro's pooler; set to 1 on a free-tier pooler).
# DB_POOL_IDLE_TIMEOUT_MS: keep idle connections warm (default 30000).
# DB_CONNECT_TIMEOUT_MS: fail fast when the pooler is down (default 5000).
# SUPABASE_AUTH_TIMEOUT_MS: middleware auth-server timeout (default 5000).
# ------------------------------------------------------------------
# DB_POOL_MAX=5
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_CONNECT_TIMEOUT_MS=5000
# SUPABASE_AUTH_TIMEOUT_MS=5000

# ------------------------------------------------------------------
# AI providers - configure at least one.
# AI_PROVIDER picks the default ("groq", "openai", or "anthropic");
# users can override it per-account in Settings.
# Groq has a free tier: https://console.groq.com/keys
# ------------------------------------------------------------------
AI_PROVIDER="groq"
GROQ_API_KEY=""
# Groq retires hosted models on a schedule (see
# https://console.groq.com/docs/deprecations). llama-3.3-70b-versatile is
# scheduled for shutdown on 2026-08-16; migrate to openai/gpt-oss-120b or
# qwen/qwen3.6-27b before then by changing this variable — no code change or
# redeploy of the app itself is needed. GET /api/health reports the model ids
# actually in use.
GROQ_MODEL="llama-3.3-70b-versatile"
# Vision model for image/scanned-invoice extraction (Groq's default text model
# cannot read images). Check https://console.groq.com/docs/vision for current ids.
GROQ_VISION_MODEL="qwen/qwen3.6-27b"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# OPENAI_VISION_MODEL defaults to OPENAI_MODEL (gpt-4o-mini reads images natively).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"
# ANTHROPIC_VISION_MODEL defaults to ANTHROPIC_MODEL (Claude reads images natively).

# ------------------------------------------------------------------
# Notifications
# ------------------------------------------------------------------
# Absolute URL of the deployed app: canonical metadata, auth redirects, and the
# links in notification emails. Production is https://app.ballastmoney.com.
# Validated at build time — a malformed value (a space instead of a dot is the
# classic) fails with a message naming this variable, not a bare "Invalid URL".
# Leave it unset locally and it falls back to http://localhost:3000.
#
# Every NEXT_PUBLIC_* value is inlined when the app is BUILT, not read at
# startup. On Vercel that is automatic. Under Docker it is not: setting this
# only in .env leaves the built image with the fallback origin, and notification
# emails then link to the wrong host. docker-compose.yml passes it (and the two
# Supabase values) through as build args, so a change here needs
# `docker compose up -d --build`, not just a restart.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: GitHub Issues new-issue URL. When set, "Report issue" opens this URL
# with prefilled title and body query params instead of mailto.
NEXT_PUBLIC_ISSUES_URL="https://github.com/OWNER/REPO/issues/new"

# Optional: fallback support email when NEXT_PUBLIC_ISSUES_URL is not set.
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Optional: credentials for authenticated local feature tests (npm run test:features).
TEST_USER_EMAIL=""
TEST_USER_PASSWORD=""

# Email channel (Resend, https://resend.com). Optional and both required: when
# either is missing, sends are reported as "not configured" and skipped —
# in-app notifications still work and team invites still work via their link.
# Resend only delivers to your own account address until you verify a sending
# domain (a send.<yourdomain> subdomain is recommended). See the README section
# "Email delivery (Resend)" and the runbook in DEPLOYMENT.md.
#
# Leave EMAIL_FROM empty rather than filling in a placeholder domain: any
# non-empty value makes the app consider the channel configured, so a
# placeholder turns an honest "not configured" into a 403 on every send.
# Accepted forms: user@domain, or Name <user@domain>.
#   EMAIL_FROM="Ballast <notifications@send.yourdomain.com>"
RESEND_API_KEY=""
EMAIL_FROM=""

# Web Push (VAPID). Optional. Generate a key pair once with:
#   npx web-push generate-vapid-keys
VAPID_SUBJECT="mailto:you@yourdomain.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Bearer token protecting every GET /api/cron/* route — notifications, sync,
# account-deletions and play-acknowledge — and the ?probe=ai / ?probe=email
# diagnostics on /api/health. Generate with `openssl rand -base64 32`. Vercel
# Cron sends it automatically once the variable exists in the project;
# self-hosted schedulers must send it themselves. Unset, every cron route
# answers 503 and does nothing.
CRON_SECRET=""

# ------------------------------------------------------------------
# Rate limiting. Optional: without these the app uses an in-process
# token bucket (fine for a single instance). Multi-instance deployments
# should point at an Upstash Redis database so limits are shared.
# ------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------
# Billing (Stripe). Optional: when the keys are missing the app runs
# fully on the Free plan (with the 14-day Pro trial) and the billing
# UI shows a "billing not configured" state.
# ------------------------------------------------------------------
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint pointing at /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=""
# Monthly recurring price ids (price_...) for the self-serve paid plans.
# The two editions have separate tiers and therefore separate prices; a
# workspace is only ever offered the set matching its type, so leaving one
# edition's ids blank disables upgrades there and nowhere else.
# Business edition: Pro EUR 19/mo, Business EUR 49/mo.
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""
# Personal edition: Plus EUR 4.99/mo, Premium EUR 8.99/mo.
STRIPE_PRICE_PERSONAL_PLUS=""
STRIPE_PRICE_PERSONAL_PREMIUM=""

# ------------------------------------------------------------------
# Billing (Google Play). Optional, and independent of Stripe: without
# these the Android app cannot sell anything, GET /api/billing/summary
# reports play.configured = false so a client hides its purchase
# buttons, and /api/billing/play/verify answers 503. Nothing here is
# read at import time and nothing crashes when it is missing.
#
# Note that Play Billing cannot be exercised from a locally signed
# debug build at all: the purchase flow needs license testers in Play
# Console and a build served from at least the internal testing track.
# ------------------------------------------------------------------
# The Android application id, exactly as it appears in Play Console.
GOOGLE_PLAY_PACKAGE_NAME=""
# The service account that reads purchases from the Google Play Developer API,
# as the whole downloaded JSON key — either raw or base64 of it, both accepted.
# One variable rather than several because the private key is multi-line PEM and
# splitting a credential across variables that must agree is how half a
# credential ends up deployed.
#
# To create it: Google Cloud Console -> IAM & Admin -> Service Accounts -> Create
# -> Keys -> Add key -> JSON. Then, in Play Console -> Users and permissions,
# invite that service account's email address and grant it "View financial data"
# and "Manage orders and subscriptions" for this app. Play Console can take up to
# 24 hours to honour a newly granted permission, so a fresh credential returning
# 401 is usually patience rather than a mistake.
#
# On one line, quoted, with the \n escapes the JSON file already contains:
#   GOOGLE_PLAY_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# Or, if the secret store mangles newlines:
#   base64 -w0 play-service-account.json
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
# The audience the Pub/Sub push subscription mints its OIDC tokens for, which is
# what /api/billing/play/notifications checks them against. Set the push endpoint
# to <NEXT_PUBLIC_APP_URL>/api/billing/play/notifications and set this to the
# same URL. Unset, that endpoint answers 503 and no Real-time Developer
# Notification is ever processed.
GOOGLE_PLAY_PUBSUB_AUDIENCE=""
# Optional, and recommended: the service account Pub/Sub signs those push tokens
# with (Google Cloud Console -> Pub/Sub -> the subscription -> Authentication ->
# Service account). When set, the token's verified `email` claim must match it,
# which narrows trust from "any Google-issued token for this audience" to one
# identity.
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT=""

# ------------------------------------------------------------------
# Integrations (Business plan). Every provider is optional — cards on
# /integrations show "Not configured" until its env vars are set.
# ------------------------------------------------------------------
# Required for ALL integrations: 32-byte key that encrypts OAuth tokens
# at rest (AES-256-GCM). Generate with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=""

# Supabase service-role key (Project Settings -> API). Needed only for
# Gmail/Outlook invoice ingestion (background jobs store documents
# without a user session).
SUPABASE_SERVICE_ROLE_KEY=""

# Plaid (https://dashboard.plaid.com) — bank transactions.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"            # sandbox | production
PLAID_COUNTRY_CODES="US"       # comma-separated, e.g. "US,NL"

# Tink (https://console.tink.com) — European bank transactions.
TINK_CLIENT_ID=""
TINK_CLIENT_SECRET=""
TINK_MARKET="GB"

# GoCardless Bank Account Data (https://bankaccountdata.gocardless.com).
# Developers -> User secrets -> "+ Create new". The secret key is shown only
# once, so download it there. Leave the IP allow-list empty unless this app has
# a fixed outbound IP — a mismatch makes every token request fail with 403.
# There is no redirect URI to register: the callback is sent with each bank
# request as <NEXT_PUBLIC_APP_URL>/api/integrations/gocardless/callback.
GOCARDLESS_SECRET_ID=""
GOCARDLESS_SECRET_KEY=""
# Default bank; users can pass ?institution=<id> on the connect URL. Set to
# SANDBOXFINANCE_SFIN0000 to also offer GoCardless's test bank in the picker.
GOCARDLESS_INSTITUTION_ID="SANDBOXFINANCE_SFIN0000"

# QuickBooks Online (https://developer.intuit.com) — bills & invoices.
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_ENV="production"    # production | sandbox

# Xero (https://developer.xero.com) — invoices.
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""

# Exact Online (https://apps.exactonline.com) — invoices.
EXACT_CLIENT_ID=""
EXACT_CLIENT_SECRET=""
EXACT_REGION="start.exactonline.nl"

# Google (https://console.cloud.google.com) — Gmail invoice ingestion
# and Google Calendar bill reminders share one OAuth app.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft Entra app (https://portal.azure.com) — Outlook mailbox scan.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Slack app with the incoming-webhook scope (https://api.slack.com/apps).
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
# Microsoft Teams needs no env vars: users paste an incoming webhook URL.

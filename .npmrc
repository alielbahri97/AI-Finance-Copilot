# On the Optiver corporate network, uncomment the registry line below
# (the public npm registry is blocked there). Leave it commented everywhere
# else — with it commented, npm uses the default public registry, so the
# repo works out of the box at home.
#
# Alternatively, leave this file untouched and set the registry per-shell:
#   $env:NPM_CONFIG_REGISTRY = "https://artifactory.ams.optiver.com/artifactory/api/npm/npm/"
#
# registry=https://artifactory.ams.optiver.com/artifactory/api/npm/npm/
#
# Prisma engine downloads (binaries.prisma.sh) need no configuration here:
# there is no Artifactory mirror for them, so scripts/prisma-generate.mjs
# detects the blocked download and retries with a placeholder engine. Set
# PRISMA_ENGINE_STUB_FALLBACK=always to skip the doomed attempt (~70s).

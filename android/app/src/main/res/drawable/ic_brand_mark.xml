<?xml version="1.0" encoding="utf-8"?>
<!--
  The Ballast mark, taken verbatim from src/lib/brand/mark.ts so the app icon
  and the website cannot drift apart. It is a balance weight: two stacked
  horizontal capsules of decreasing length above a stem and a ballast bulb,
  with the visual weight low on purpose.

  The web source authors the geometry on a 24x24 grid but sets the viewBox to
  the mark's exact bounding box (3.5 5 17 16.2) so a square canvas letterboxes
  it dead centre. This drawable keeps the 24x24 viewport and relies on the
  paths already sitting centred within it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/ballast_brand">

    <!-- Top bar: longest capsule, height 2.2, radius 1.1. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4.6 5 H19.4 C20.0075 5 20.5 5.4925 20.5 6.1 C20.5 6.7075 20.0075 7.2 19.4 7.2 H4.6 C3.9925 7.2 3.5 6.7075 3.5 6.1 C3.5 5.4925 3.9925 5 4.6 5 Z" />
    <!-- Middle bar: shorter capsule, same thickness, gap about one bar height. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7.6 9.2 H16.4 C17.0075 9.2 17.5 9.6925 17.5 10.3 C17.5 10.9075 17.0075 11.4 16.4 11.4 H7.6 C6.9925 11.4 6.5 10.9075 6.5 10.3 C6.5 9.6925 6.9925 9.2 7.6 9.2 Z" />
    <!-- Stem: thin connector into the bulb. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11.35 11 H12.65 V15.4 H11.35 Z" />
    <!-- Ballast bulb: circle of radius 2.9 centred at (12, 18.3). -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M14.9 18.3 C14.9 19.9017 13.6017 21.2 12 21.2 C10.3983 21.2 9.1 19.9017 9.1 18.3 C9.1 16.6983 10.3983 15.4 12 15.4 C13.6017 15.4 14.9 16.6983 14.9 18.3 Z" />
</vector>

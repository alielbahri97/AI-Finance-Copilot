// Prisma schema for the AI Finance Copilot.
// The database lives in Supabase PostgreSQL; auth users are managed by
// Supabase Auth and mirrored here via the Profile model (same UUID).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum ChatRole {
  USER
  ASSISTANT
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  GROQ
}

enum InvoiceStatus {
  /// Uploaded but not yet confirmed by the user in the review form.
  DRAFT
  UNPAID
  PAID
}

enum InvoiceDirection {
  /// Money the user owes (a bill from a vendor). Unpaid payables = AP.
  PAYABLE
  /// Money owed to the user (an invoice they issued). Unpaid receivables = AR.
  RECEIVABLE
}

enum ExtractionStatus {
  /// AI extraction succeeded; fields were pre-filled for review.
  EXTRACTED
  /// Extraction failed or the document had no readable text; manual entry.
  NEEDS_REVIEW
  /// Created without automatic extraction.
  MANUAL
}

enum IntegrationStatus {
  CONNECTED
  ERROR
  EXPIRED
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum PlanId {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum ReferralStatus {
  /// The referred user signed up but has not upgraded to a paid plan yet.
  PENDING
  /// The referred user upgraded; the referrer received their reward.
  CONVERTED
}

enum NotificationType {
  DAILY_SUMMARY
  WEEKLY_SUMMARY
  MONTHLY_SUMMARY
  LARGE_TRANSACTION
  LOW_CASH
  INVOICE_REMINDER
}

enum AssumptionKind {
  /// A single future income/expense on a specific date.
  ONE_OFF
  /// A monthly recurring adjustment, optionally bounded by start/end dates.
  RECURRING
  /// A compounding % growth per month applied to projected income or expenses.
  PERCENT_GROWTH
}

model Profile {
  /// Matches the Supabase Auth user id.
  id         String     @id @db.Uuid
  email      String     @unique
  fullName   String?    @map("full_name")
  avatarUrl  String?    @map("avatar_url")
  currency   String     @default("USD")
  aiProvider AiProvider @default(OPENAI) @map("ai_provider")
  /// Grants access to /admin. Set manually in the database:
  /// UPDATE profiles SET is_admin = true WHERE email = '...';
  isAdmin      Boolean @default(false) @map("is_admin")
  /// This user's shareable referral code (generated on first billing access).
  referralCode String? @unique @map("referral_code")
  /// The user who referred this account, captured from /signup?ref=CODE.
  referredById String? @map("referred_by_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  transactions           Transaction[]
  budgets                Budget[]
  chatMessages           ChatMessage[]
  categories             Category[]
  categoryRules          CategoryRule[]
  importBatches          ImportBatch[]
  conversations          Conversation[]
  assumptions            Assumption[]
  invoices               Invoice[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  pushSubscriptions      PushSubscription[]
  subscription           Subscription?
  usageRecords           UsageRecord[]
  referralsMade          Referral[]              @relation("Referrer")
  referralReceived       Referral?               @relation("Referred")
  analyticsEvents        AnalyticsEvent[]
  integrationConnections IntegrationConnection[]

  @@map("profiles")
}

/// A user's link to an external provider (bank, accounting, productivity).
/// Tokens are encrypted at rest with AES-256-GCM (INTEGRATION_ENCRYPTION_KEY).
model IntegrationConnection {
  id       String            @id @default(cuid())
  userId   String            @map("user_id") @db.Uuid
  provider String
  status   IntegrationStatus @default(CONNECTED)

  /// Encrypted (iv || tag || ciphertext, base64). For webhook-style providers
  /// (Slack incoming webhook, Teams) this holds the encrypted webhook URL.
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")

  /// External account info and per-provider options (realmId, tenantId,
  /// account ids, channel name, calendar toggle...). Never holds secrets.
  metadata Json?

  lastSyncAt          DateTime? @map("last_sync_at")
  lastError           String?   @map("last_error")
  /// Failed syncs in a row; drives exponential backoff in the cron.
  consecutiveFailures Int       @default(0) @map("consecutive_failures")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile  Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncRuns SyncRun[]

  @@unique([userId, provider])
  @@map("integration_connections")
}

/// One synchronization attempt for a connection.
model SyncRun {
  id           String        @id @default(cuid())
  connectionId String        @map("connection_id")
  startedAt    DateTime      @default(now()) @map("started_at")
  finishedAt   DateTime?     @map("finished_at")
  status       SyncRunStatus @default(RUNNING)
  /// Provider-specific counters, e.g. { imported: 12, duplicates: 3 }.
  stats        Json?
  error        String?

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt(sort: Desc)])
  @@map("sync_runs")
}

/// The user's billing state. Free/trial users have a row with no Stripe ids;
/// paid users are kept in sync by the Stripe webhook.
model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique @map("user_id") @db.Uuid
  plan                 PlanId             @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  stripePriceId        String?            @map("stripe_price_id")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  /// Local card-free Pro trial: 14 days on signup, extended by referral rewards.
  trialEndsAt          DateTime?          @map("trial_ends_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// Metered usage per user per calendar month (period = "YYYY-MM").
model UsageRecord {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id") @db.Uuid
  period             String
  aiMessages         Int      @default(0) @map("ai_messages")
  csvImports         Int      @default(0) @map("csv_imports")
  invoiceExtractions Int      @default(0) @map("invoice_extractions")
  exports            Int      @default(0)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@map("usage_records")
}

/// One row per referred signup. Converted referrals grant the referrer
/// +1 month of Pro credit (applied as a trial extension).
model Referral {
  id             String         @id @default(cuid())
  referrerId     String         @map("referrer_id") @db.Uuid
  referredUserId String         @unique @map("referred_user_id") @db.Uuid
  code           String
  status         ReferralStatus @default(PENDING)
  createdAt      DateTime       @default(now()) @map("created_at")
  convertedAt    DateTime?      @map("converted_at")

  referrer Profile @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred Profile @relation("Referred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referrals")
}

/// Lightweight internal analytics; no third-party trackers.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id") @db.Uuid
  name      String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([createdAt])
  @@map("analytics_events")
}

/// An in-app notification; the always-available channel. Email and push are
/// fan-out copies of the same event.
model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  /// Optional deep link into the app (e.g. /invoices or /forecast).
  link      String?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

/// One row per user: per-type and per-channel toggles plus the last-sent
/// timestamps that make the cron endpoint idempotent.
model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique @map("user_id") @db.Uuid

  dailySummary   Boolean @default(false) @map("daily_summary")
  weeklySummary  Boolean @default(true) @map("weekly_summary")
  monthlySummary Boolean @default(true) @map("monthly_summary")

  largeTransaction          Boolean @default(true) @map("large_transaction")
  largeTransactionThreshold Decimal @default(1000) @map("large_transaction_threshold") @db.Decimal(12, 2)

  lowCash            Boolean @default(true) @map("low_cash")
  lowCashFloor       Decimal @default(0) @map("low_cash_floor") @db.Decimal(14, 2)
  lowCashHorizonDays Int     @default(30) @map("low_cash_horizon_days")

  invoiceReminders Boolean @default(true) @map("invoice_reminders")

  channelInApp Boolean @default(true) @map("channel_in_app")
  channelEmail Boolean @default(true) @map("channel_email")
  channelPush  Boolean @default(false) @map("channel_push")

  lastDailySentAt     DateTime? @map("last_daily_sent_at")
  lastWeeklySentAt    DateTime? @map("last_weekly_sent_at")
  lastMonthlySentAt   DateTime? @map("last_monthly_sent_at")
  lastLowCashAt       DateTime? @map("last_low_cash_at")
  lastInvoiceRemindAt DateTime? @map("last_invoice_remind_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// A browser Web Push subscription (VAPID). A user can have several
/// (one per browser/device); dead endpoints are pruned on send.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// An uploaded invoice/receipt document with extracted metadata.
model Invoice {
  id               String           @id @default(cuid())
  userId           String           @map("user_id") @db.Uuid
  vendor           String           @default("")
  invoiceNumber    String?          @map("invoice_number")
  invoiceDate      DateTime?        @map("invoice_date")
  dueDate          DateTime?        @map("due_date")
  currency         String           @default("USD")
  subtotal         Decimal?         @db.Decimal(12, 2)
  vatAmount        Decimal?         @map("vat_amount") @db.Decimal(12, 2)
  /// VAT rate in percent (e.g. 21.00).
  vatRate          Decimal?         @map("vat_rate") @db.Decimal(5, 2)
  total            Decimal          @default(0) @db.Decimal(12, 2)
  direction        InvoiceDirection @default(PAYABLE)
  status           InvoiceStatus    @default(DRAFT)
  extractionStatus ExtractionStatus @default(NEEDS_REVIEW) @map("extraction_status")
  /// Object path in the private Supabase Storage bucket (userId/invoiceId/filename).
  storagePath      String           @map("storage_path")
  fileName         String           @map("file_name")
  mimeType         String           @map("mime_type")
  notes            String?
  /// Linked bank transaction; linking marks the invoice paid.
  transactionId    String?          @unique @map("transaction_id")
  /// Stable id of the source record for integration syncs, e.g.
  /// "xero:INV-123" — used to dedupe re-synced invoices.
  externalRef      String?          @map("external_ref")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  profile     Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  lineItems   InvoiceLineItem[]

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, externalRef])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)
  total       Decimal @default(0) @db.Decimal(12, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

/// A user-defined adjustment applied on top of the data-driven cash forecast.
model Assumption {
  id        String          @id @default(cuid())
  userId    String          @map("user_id") @db.Uuid
  kind      AssumptionKind
  type      TransactionType
  label     String
  /// Amount for ONE_OFF and RECURRING assumptions.
  amount    Decimal?        @db.Decimal(12, 2)
  /// % per month for PERCENT_GROWTH assumptions.
  percent   Decimal?        @db.Decimal(6, 2)
  /// The date of a ONE_OFF assumption.
  date      DateTime?
  startDate DateTime?       @map("start_date")
  endDate   DateTime?       @map("end_date")
  enabled   Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("assumptions")
}

model Category {
  id        String          @id @default(cuid())
  userId    String          @map("user_id") @db.Uuid
  name      String
  type      TransactionType
  color     String          @default("#6366f1")
  /// Seeded default categories; users can still rename/delete them.
  isDefault Boolean         @default(false) @map("is_default")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  profile      Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  rules        CategoryRule[]

  @@unique([userId, name])
  @@index([userId, type])
  @@map("categories")
}

/// Auto-categorization rule: transactions whose description or counterparty
/// contains `pattern` (case-insensitive) get assigned `categoryId`.
model CategoryRule {
  id         String   @id @default(cuid())
  userId     String   @map("user_id") @db.Uuid
  pattern    String
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  profile  Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, pattern])
  @@index([userId])
  @@map("category_rules")
}

/// One CSV upload. Deleting a batch cascades to its transactions,
/// which is how an import gets undone.
model ImportBatch {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  fileName  String   @map("file_name")
  createdAt DateTime @default(now()) @map("created_at")

  profile      Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("import_batches")
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String          @map("user_id") @db.Uuid
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  categoryId    String?         @map("category_id")
  description   String
  counterparty  String?
  date          DateTime
  /// Account balance after this transaction, when the bank statement provides it.
  balance       Decimal?        @db.Decimal(14, 2)
  /// Fingerprint of imported rows, used to skip duplicates across imports.
  hash          String?
  importBatchId String?         @map("import_batch_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  profile     Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  invoice     Invoice?

  @@unique([userId, hash])
  @@index([userId, date(sort: Desc)])
  @@index([userId, categoryId])
  @@index([userId, importBatchId])
  @@map("transactions")
}

model Budget {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  category  String
  limit     Decimal  @db.Decimal(12, 2)
  month     Int
  year      Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month, year])
  @@map("budgets")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile  Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("conversations")
}

model ChatMessage {
  id             String   @id @default(cuid())
  userId         String   @map("user_id") @db.Uuid
  conversationId String   @map("conversation_id")
  role           ChatRole
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  profile      Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@map("chat_messages")
}

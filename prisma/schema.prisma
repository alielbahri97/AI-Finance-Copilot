// Prisma schema for the AI Finance Copilot.
// The database lives in Supabase PostgreSQL; auth users are managed by
// Supabase Auth and mirrored here via the Profile model (same UUID).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum ChatRole {
  USER
  ASSISTANT
}

enum AiProvider {
  OPENAI
  ANTHROPIC
}

model Profile {
  /// Matches the Supabase Auth user id.
  id         String     @id @db.Uuid
  email      String     @unique
  fullName   String?    @map("full_name")
  avatarUrl  String?    @map("avatar_url")
  currency   String     @default("USD")
  aiProvider AiProvider @default(OPENAI) @map("ai_provider")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  transactions  Transaction[]
  budgets       Budget[]
  chatMessages  ChatMessage[]
  categories    Category[]
  categoryRules CategoryRule[]
  importBatches ImportBatch[]
  conversations Conversation[]

  @@map("profiles")
}

model Category {
  id        String          @id @default(cuid())
  userId    String          @map("user_id") @db.Uuid
  name      String
  type      TransactionType
  color     String          @default("#6366f1")
  /// Seeded default categories; users can still rename/delete them.
  isDefault Boolean         @default(false) @map("is_default")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  profile      Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  rules        CategoryRule[]

  @@unique([userId, name])
  @@index([userId, type])
  @@map("categories")
}

/// Auto-categorization rule: transactions whose description or counterparty
/// contains `pattern` (case-insensitive) get assigned `categoryId`.
model CategoryRule {
  id         String   @id @default(cuid())
  userId     String   @map("user_id") @db.Uuid
  pattern    String
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  profile  Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, pattern])
  @@index([userId])
  @@map("category_rules")
}

/// One CSV upload. Deleting a batch cascades to its transactions,
/// which is how an import gets undone.
model ImportBatch {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  fileName  String   @map("file_name")
  createdAt DateTime @default(now()) @map("created_at")

  profile      Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("import_batches")
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String          @map("user_id") @db.Uuid
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  categoryId    String?         @map("category_id")
  description   String
  counterparty  String?
  date          DateTime
  /// Account balance after this transaction, when the bank statement provides it.
  balance       Decimal?        @db.Decimal(14, 2)
  /// Fingerprint of imported rows, used to skip duplicates across imports.
  hash          String?
  importBatchId String?         @map("import_batch_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  profile     Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([userId, hash])
  @@index([userId, date(sort: Desc)])
  @@index([userId, categoryId])
  @@index([userId, importBatchId])
  @@map("transactions")
}

model Budget {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  category  String
  limit     Decimal  @db.Decimal(12, 2)
  month     Int
  year      Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month, year])
  @@map("budgets")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile  Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("conversations")
}

model ChatMessage {
  id             String   @id @default(cuid())
  userId         String   @map("user_id") @db.Uuid
  conversationId String   @map("conversation_id")
  role           ChatRole
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  profile      Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@map("chat_messages")
}

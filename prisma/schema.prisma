// Prisma schema for the AI Finance Copilot.
// The database lives in Supabase PostgreSQL; auth users are managed by
// Supabase Auth and mirrored here via the Profile model (same UUID).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum ChatRole {
  USER
  ASSISTANT
}

enum AiProvider {
  OPENAI
  ANTHROPIC
}

enum InvoiceStatus {
  /// Uploaded but not yet confirmed by the user in the review form.
  DRAFT
  UNPAID
  PAID
}

enum InvoiceDirection {
  /// Money the user owes (a bill from a vendor). Unpaid payables = AP.
  PAYABLE
  /// Money owed to the user (an invoice they issued). Unpaid receivables = AR.
  RECEIVABLE
}

enum ExtractionStatus {
  /// AI extraction succeeded; fields were pre-filled for review.
  EXTRACTED
  /// Extraction failed or the document had no readable text; manual entry.
  NEEDS_REVIEW
  /// Created without automatic extraction.
  MANUAL
}

enum AssumptionKind {
  /// A single future income/expense on a specific date.
  ONE_OFF
  /// A monthly recurring adjustment, optionally bounded by start/end dates.
  RECURRING
  /// A compounding % growth per month applied to projected income or expenses.
  PERCENT_GROWTH
}

model Profile {
  /// Matches the Supabase Auth user id.
  id         String     @id @db.Uuid
  email      String     @unique
  fullName   String?    @map("full_name")
  avatarUrl  String?    @map("avatar_url")
  currency   String     @default("USD")
  aiProvider AiProvider @default(OPENAI) @map("ai_provider")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  transactions  Transaction[]
  budgets       Budget[]
  chatMessages  ChatMessage[]
  categories    Category[]
  categoryRules CategoryRule[]
  importBatches ImportBatch[]
  conversations Conversation[]
  assumptions   Assumption[]
  invoices      Invoice[]

  @@map("profiles")
}

/// An uploaded invoice/receipt document with extracted metadata.
model Invoice {
  id               String           @id @default(cuid())
  userId           String           @map("user_id") @db.Uuid
  vendor           String           @default("")
  invoiceNumber    String?          @map("invoice_number")
  invoiceDate      DateTime?        @map("invoice_date")
  dueDate          DateTime?        @map("due_date")
  currency         String           @default("USD")
  subtotal         Decimal?         @db.Decimal(12, 2)
  vatAmount        Decimal?         @map("vat_amount") @db.Decimal(12, 2)
  /// VAT rate in percent (e.g. 21.00).
  vatRate          Decimal?         @map("vat_rate") @db.Decimal(5, 2)
  total            Decimal          @default(0) @db.Decimal(12, 2)
  direction        InvoiceDirection @default(PAYABLE)
  status           InvoiceStatus    @default(DRAFT)
  extractionStatus ExtractionStatus @default(NEEDS_REVIEW) @map("extraction_status")
  /// Object path in the private Supabase Storage bucket (userId/invoiceId/filename).
  storagePath      String           @map("storage_path")
  fileName         String           @map("file_name")
  mimeType         String           @map("mime_type")
  notes            String?
  /// Linked bank transaction; linking marks the invoice paid.
  transactionId    String?          @unique @map("transaction_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  profile     Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  lineItems   InvoiceLineItem[]

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, createdAt(sort: Desc)])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)
  total       Decimal @default(0) @db.Decimal(12, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

/// A user-defined adjustment applied on top of the data-driven cash forecast.
model Assumption {
  id        String          @id @default(cuid())
  userId    String          @map("user_id") @db.Uuid
  kind      AssumptionKind
  type      TransactionType
  label     String
  /// Amount for ONE_OFF and RECURRING assumptions.
  amount    Decimal?        @db.Decimal(12, 2)
  /// % per month for PERCENT_GROWTH assumptions.
  percent   Decimal?        @db.Decimal(6, 2)
  /// The date of a ONE_OFF assumption.
  date      DateTime?
  startDate DateTime?       @map("start_date")
  endDate   DateTime?       @map("end_date")
  enabled   Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("assumptions")
}

model Category {
  id        String          @id @default(cuid())
  userId    String          @map("user_id") @db.Uuid
  name      String
  type      TransactionType
  color     String          @default("#6366f1")
  /// Seeded default categories; users can still rename/delete them.
  isDefault Boolean         @default(false) @map("is_default")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  profile      Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  rules        CategoryRule[]

  @@unique([userId, name])
  @@index([userId, type])
  @@map("categories")
}

/// Auto-categorization rule: transactions whose description or counterparty
/// contains `pattern` (case-insensitive) get assigned `categoryId`.
model CategoryRule {
  id         String   @id @default(cuid())
  userId     String   @map("user_id") @db.Uuid
  pattern    String
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  profile  Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, pattern])
  @@index([userId])
  @@map("category_rules")
}

/// One CSV upload. Deleting a batch cascades to its transactions,
/// which is how an import gets undone.
model ImportBatch {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  fileName  String   @map("file_name")
  createdAt DateTime @default(now()) @map("created_at")

  profile      Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("import_batches")
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String          @map("user_id") @db.Uuid
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  categoryId    String?         @map("category_id")
  description   String
  counterparty  String?
  date          DateTime
  /// Account balance after this transaction, when the bank statement provides it.
  balance       Decimal?        @db.Decimal(14, 2)
  /// Fingerprint of imported rows, used to skip duplicates across imports.
  hash          String?
  importBatchId String?         @map("import_batch_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  profile     Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  invoice     Invoice?

  @@unique([userId, hash])
  @@index([userId, date(sort: Desc)])
  @@index([userId, categoryId])
  @@index([userId, importBatchId])
  @@map("transactions")
}

model Budget {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  category  String
  limit     Decimal  @db.Decimal(12, 2)
  month     Int
  year      Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month, year])
  @@map("budgets")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile  Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("conversations")
}

model ChatMessage {
  id             String   @id @default(cuid())
  userId         String   @map("user_id") @db.Uuid
  conversationId String   @map("conversation_id")
  role           ChatRole
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  profile      Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@map("chat_messages")
}

// Prisma schema for Ballast.
// The database lives in Supabase PostgreSQL; auth users are managed by
// Supabase Auth and mirrored here via the Profile model (same UUID).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum ChatRole {
  USER
  ASSISTANT
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  GROQ
}

enum InvoiceStatus {
  /// Uploaded but not yet confirmed by the user in the review form.
  DRAFT
  UNPAID
  PAID
}

enum InvoiceDirection {
  /// Money the user owes (a bill from a vendor). Unpaid payables = AP.
  PAYABLE
  /// Money owed to the user (an invoice they issued). Unpaid receivables = AR.
  RECEIVABLE
}

/// Rungs of the customer-facing payment-reminder ladder, picked from how far
/// an unpaid receivable is from its due date. Each rung is sent at most once
/// per invoice — see the ReminderLog uniqueness below.
enum DunningStep {
  /// Due within the next 7 days: a friendly heads-up before anything is late.
  DUE_SOON
  /// 1-14 days late.
  OVERDUE_1
  /// 15-30 days late.
  OVERDUE_2
  /// More than 30 days late: the last reminder Ballast sends by itself.
  FINAL
}

enum ExtractionStatus {
  /// AI extraction succeeded; fields were pre-filled for review.
  EXTRACTED
  /// Extraction failed or the document had no readable text; manual entry.
  NEEDS_REVIEW
  /// Created without automatic extraction.
  MANUAL
}

enum IntegrationStatus {
  CONNECTED
  ERROR
  EXPIRED
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// Plan tiers across both editions. FREE is shared (its limits differ per
/// edition); PRO/BUSINESS/ENTERPRISE are Business-edition tiers and
/// PLUS/PREMIUM are Personal-edition tiers. Which set applies is decided by
/// the workspace's type — see src/lib/billing/plans.ts.
enum PlanId {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
  PLUS
  PREMIUM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum ReferralStatus {
  /// The referred user signed up but has not upgraded to a paid plan yet.
  PENDING
  /// The referred user upgraded; the referrer received their reward.
  CONVERTED
}

enum NotificationType {
  DAILY_SUMMARY
  WEEKLY_SUMMARY
  MONTHLY_SUMMARY
  LARGE_TRANSACTION
  LOW_CASH
  INVOICE_REMINDER
  /// Team events: added to a workspace, role changed, removed.
  WORKSPACE
}

/// Which edition of the product a workspace is. One codebase, two editions:
/// the shared core (transactions, categories, banks, forecasts, copilot,
/// notifications) works for both, and the type decides which surfaces exist.
enum WorkspaceType {
  /// Companies: invoices with VAT extraction, AR/AP, vendors and customers,
  /// executive reports, multi-member team sharing.
  BUSINESS
  /// Individuals: budgets, savings goals, subscription tracking. Single-user
  /// by design — the workspace model is kept, the team UI is not.
  PERSONAL
}

enum WorkspaceRole {
  /// Full control including deletion; exactly the creator by default.
  OWNER
  /// Everything except transferring/deleting the workspace.
  ADMIN
  /// Edit-level access to business data, no member/billing management.
  MEMBER
  /// Read-only access.
  VIEWER
}

enum AssumptionKind {
  /// A single future income/expense on a specific date.
  ONE_OFF
  /// A monthly recurring adjustment, optionally bounded by start/end dates.
  RECURRING
  /// A compounding % growth per month applied to projected income or expenses.
  PERCENT_GROWTH
}

/// What a manually tracked holding is. The first six are things a person
/// owns, the last four things they owe. Which side of the balance a kind
/// falls on is decided in exactly one place — `isLiabilityKind()` in
/// src/lib/personal/net-worth.ts — rather than stored per row, so a holding
/// can never disagree with its own kind.
enum AssetKind {
  /// A house, a flat, land.
  PROPERTY
  VEHICLE
  /// Brokerage accounts, funds, pensions: a balance the user reads off a
  /// statement, not a holdings-level feed.
  INVESTMENT
  CRYPTO
  /// Money held somewhere no bank connection reaches — cash, a foreign
  /// account, a savings pot at a bank Ballast cannot sync.
  CASH
  OTHER_ASSET
  LOAN
  MORTGAGE
  /// A credit card or overdraft: the outstanding balance, entered positive.
  CREDIT_LINE
  OTHER_LIABILITY
}

enum BusinessType {
  RESTAURANT
  RETAIL
  SERVICES
  SAAS
  CONSTRUCTION
  PROFESSIONAL
  HEALTHCARE
  MANUFACTURING
  OTHER
}

enum EmployeeRange {
  SOLO
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

/// A shared workspace: all business data (transactions, invoices, forecasts,
/// integrations, billing) belongs to a workspace, and users access it through
/// a WorkspaceMember row. Every user gets a personal workspace on signup
/// (id "ws-<userId>"); multi-member workspaces are a paid-plan feature.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  /// Which edition this workspace runs. Every workspace that existed before
  /// the Personal edition is BUSINESS, which is what the default preserves.
  type      WorkspaceType @default(BUSINESS)
  /// Currency for the workspace's shared data.
  currency  String   @default("USD")
  /// Opt-out for AI categorization of imported transactions. On by default;
  /// rule matching and manual categorization are unaffected either way.
  aiCategorizationEnabled Boolean @default(true) @map("ai_categorization_enabled")
  /// Whether the hourly cron may email customers about overdue receivables on
  /// the workspace's behalf. Off by default: nothing leaves the building under
  /// someone's own name until they ask for it.
  autoDunningEnabled      Boolean @default(false) @map("auto_dunning_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members      WorkspaceMember[]
  invitations  WorkspaceInvitation[]
  auditLogs    AuditLog[]
  subscription Subscription?
  usageRecords UsageRecord[]

  transactions           Transaction[]
  categories             Category[]
  categoryRules          CategoryRule[]
  importBatches          ImportBatch[]
  invoices               Invoice[]
  assumptions            Assumption[]
  scenarios              Scenario[]
  conversations          Conversation[]
  budgets                Budget[]
  savingsGoals           SavingsGoal[]
  assets                 Asset[]
  integrationConnections IntegrationConnection[]

  @@index([type])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  /// Per-member permission overrides on top of the role defaults, e.g.
  /// { "export_data": false, "manage_integrations": true }. Ignored for OWNER.
  permissions Json?
  joinedAt    DateTime      @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

/// A pending email invitation. Only the SHA-256 hash of the invite token is
/// stored; the raw token lives solely in the emailed link. Single-use,
/// 7-day expiry, bound to the invited email address.
model WorkspaceInvitation {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  email       String
  role        WorkspaceRole @default(MEMBER)
  tokenHash   String        @unique @map("token_hash")
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  revokedAt   DateTime?     @map("revoked_at")
  invitedById String        @map("invited_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy Profile   @relation("Inviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("workspace_invitations")
}

/// Security audit trail: member/permission/billing changes, deletions and
/// exports. Visible to owners and admins in the Team settings.
model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  /// The acting user; null for system actions (cron, webhooks).
  userId      String?  @map("user_id") @db.Uuid
  action      String
  detail      Json?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   Profile?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Profile {
  /// Matches the Supabase Auth user id.
  id         String     @id @db.Uuid
  email      String     @unique
  fullName   String?    @map("full_name")
  avatarUrl  String?    @map("avatar_url")
  currency   String     @default("USD")
  aiProvider AiProvider @default(GROQ) @map("ai_provider")
  /// Grants access to /admin. Set manually in the database:
  /// UPDATE profiles SET is_admin = true WHERE email = '...';
  isAdmin      Boolean @default(false) @map("is_admin")
  /// This user's shareable referral code (generated on first billing access).
  referralCode String? @unique @map("referral_code")
  /// The user who referred this account, captured from /signup?ref=CODE.
  referredById String? @map("referred_by_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  transactions           Transaction[]
  budgets                Budget[]
  savingsGoals           SavingsGoal[]
  assets                 Asset[]
  chatMessages           ChatMessage[]
  categories             Category[]
  categoryRules          CategoryRule[]
  importBatches          ImportBatch[]
  conversations          Conversation[]
  assumptions            Assumption[]
  invoices               Invoice[]
  remindersSent          ReminderLog[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  pushSubscriptions      PushSubscription[]
  /// Workspace subscriptions this user set up (informational back-relation).
  subscriptionsManaged   Subscription[]
  usageRecords           UsageRecord[]
  referralsMade          Referral[]              @relation("Referrer")
  referralReceived       Referral?               @relation("Referred")
  analyticsEvents        AnalyticsEvent[]
  integrationConnections IntegrationConnection[]
  businessProfile        BusinessProfile?
  helpMessages           HelpMessage[]
  workspaceMemberships   WorkspaceMember[]
  invitationsSent        WorkspaceInvitation[]   @relation("Inviter")
  auditLogs              AuditLog[]

  @@map("profiles")
}

/// Support/help-agent chat: one lightweight thread per user, separate from
/// the finance copilot's conversations (different quota, different prompt).
model HelpMessage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  role      ChatRole
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("help_messages")
}

/// Captures light business context from post-signup onboarding so Ballast
/// can surface industry-typical financial ratio guidelines.
model BusinessProfile {
  id              String         @id @default(cuid())
  userId          String         @unique @map("user_id") @db.Uuid
  businessType    BusinessType   @map("business_type")
  employeeRange   EmployeeRange  @map("employee_range")
  /// Approximate monthly rent / occupancy cost (optional).
  monthlyRent     Decimal?       @map("monthly_rent") @db.Decimal(12, 2)
  /// Approximate monthly revenue (optional).
  monthlyRevenue  Decimal?       @map("monthly_revenue") @db.Decimal(14, 2)
  /// Free-form country or city (currency lives on Profile).
  location        String?
  /// Extra detail when businessType is OTHER (or any clarifying note).
  businessNotes   String?        @map("business_notes")
  /// Set when the user finishes the onboarding wizard.
  completedAt     DateTime?      @map("completed_at")
  /// Set when the user skips onboarding; they can still fill this in later.
  skippedAt       DateTime?      @map("skipped_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

/// A user's link to an external provider (bank, accounting, productivity).
/// Tokens are encrypted at rest with AES-256-GCM (INTEGRATION_ENCRYPTION_KEY).
///
/// A workspace can hold SEVERAL connections to the same provider — one per
/// bank (ING current + Rabobank savings). `externalId` is what tells them
/// apart; see the uniqueness note below.
model IntegrationConnection {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  /// The member who connected the provider (their OAuth identity).
  userId      String            @map("user_id") @db.Uuid
  provider    String
  /// The provider's stable identifier for THIS connection: the GoCardless
  /// institution id, Plaid item id, QuickBooks realmId, Xero tenantId...
  /// Null for providers where only one connection makes sense (Slack, Teams,
  /// a mailbox) and for legacy rows whose id was not derivable from metadata.
  externalId  String?           @map("external_id")
  /// User-chosen label ("ING business"); falls back to institutionName.
  displayName String?           @map("display_name")
  /// Bank/organisation name and logo as reported by the provider.
  institutionName String?       @map("institution_name")
  institutionLogo String?       @map("institution_logo")
  status      IntegrationStatus @default(CONNECTED)

  /// Encrypted (iv || tag || ciphertext, base64). For webhook-style providers
  /// (Slack incoming webhook, Teams) this holds the encrypted webhook URL.
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")

  /// External account info and per-provider options (realmId, tenantId,
  /// account ids, channel name, calendar toggle...). Never holds secrets.
  metadata Json?

  lastSyncAt          DateTime? @map("last_sync_at")
  lastError           String?   @map("last_error")
  /// Failed syncs in a row; drives exponential backoff in the cron.
  consecutiveFailures Int       @default(0) @map("consecutive_failures")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile      Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncRuns     SyncRun[]
  bankAccounts BankAccount[]

  /// Postgres treats NULLs as distinct, so this constraint alone would allow
  /// unlimited externalId-less rows. 0016 therefore also creates a PARTIAL
  /// unique index — integration_connections_workspace_provider_null_key on
  /// (workspace_id, provider) WHERE external_id IS NULL — which Prisma cannot
  /// express. Net effect: many genuine connections per provider, but at most
  /// one anonymous one.
  @@unique([workspaceId, provider, externalId])
  @@index([workspaceId, provider])
  @@map("integration_connections")
}

/// One account inside a bank connection (a requisition typically returns
/// several: current, savings, credit card). Holds the latest balance snapshot
/// so the aggregated cash view is a plain query, and the per-account
/// `includeInTotals` switch that lets a personal account sit out of the totals.
model BankAccount {
  id                String    @id @default(cuid())
  connectionId      String    @map("connection_id")
  /// The provider's account id, used as the sync/dedupe key.
  externalAccountId String    @map("external_account_id")
  /// Provider-supplied account name, when there is one.
  name              String?
  /// Masked identifier shown in the UI ("…1234"). Never the full IBAN.
  mask              String?
  currency          String?
  includeInTotals   Boolean   @default(true) @map("include_in_totals")
  lastBalance       Decimal?  @map("last_balance") @db.Decimal(14, 2)
  lastBalanceAt     DateTime? @map("last_balance_at")
  /// Berlin Group balance type the snapshot came from (interimAvailable...).
  balanceType       String?   @map("balance_type")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  savingsGoals SavingsGoal[]

  @@unique([connectionId, externalAccountId])
  @@map("bank_accounts")
}

/// One synchronization attempt for a connection.
model SyncRun {
  id           String        @id @default(cuid())
  connectionId String        @map("connection_id")
  startedAt    DateTime      @default(now()) @map("started_at")
  finishedAt   DateTime?     @map("finished_at")
  status       SyncRunStatus @default(RUNNING)
  /// Provider-specific counters, e.g. { imported: 12, duplicates: 3 }.
  stats        Json?
  error        String?

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt(sort: Desc)])
  @@map("sync_runs")
}

/// The workspace's billing state. Free/trial workspaces have a row with no
/// Stripe ids; paid workspaces are kept in sync by the Stripe webhook.
model Subscription {
  id                   String             @id @default(cuid())
  workspaceId          String             @unique @map("workspace_id")
  /// The member who set up billing (informational).
  userId               String?            @map("user_id") @db.Uuid
  plan                 PlanId             @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  stripePriceId        String?            @map("stripe_price_id")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  /// Local card-free trial of the edition's middle tier: 14 days on signup,
  /// extended by referral rewards.
  trialEndsAt          DateTime?          @map("trial_ends_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   Profile?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("subscriptions")
}

/// Metered usage per workspace per calendar month (period = "YYYY-MM").
model UsageRecord {
  id                 String   @id @default(cuid())
  workspaceId        String   @map("workspace_id")
  /// Legacy column from the per-user era; not used for quota decisions.
  userId             String?  @map("user_id") @db.Uuid
  period             String
  aiMessages         Int      @default(0) @map("ai_messages")
  /// Transactions handed to the AI categorizer this period.
  aiCategorizations  Int      @default(0) @map("ai_categorizations")
  csvImports         Int      @default(0) @map("csv_imports")
  invoiceExtractions Int      @default(0) @map("invoice_extractions")
  exports            Int      @default(0)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   Profile?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, period])
  @@map("usage_records")
}

/// One row per referred signup. Converted referrals grant the referrer 30 more
/// days of trial credit, worth whatever tier their edition trials.
model Referral {
  id             String         @id @default(cuid())
  referrerId     String         @map("referrer_id") @db.Uuid
  referredUserId String         @unique @map("referred_user_id") @db.Uuid
  code           String
  status         ReferralStatus @default(PENDING)
  createdAt      DateTime       @default(now()) @map("created_at")
  convertedAt    DateTime?      @map("converted_at")

  referrer Profile @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred Profile @relation("Referred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referrals")
}

/// Lightweight internal analytics; no third-party trackers.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id") @db.Uuid
  name      String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([createdAt])
  @@map("analytics_events")
}

/// An in-app notification; the always-available channel. Email and push are
/// fan-out copies of the same event.
model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  /// Optional deep link into the app (e.g. /invoices or /forecast).
  link      String?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

/// One row per user: per-type and per-channel toggles plus the last-sent
/// timestamps that make the cron endpoint idempotent.
model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique @map("user_id") @db.Uuid

  dailySummary   Boolean @default(false) @map("daily_summary")
  weeklySummary  Boolean @default(true) @map("weekly_summary")
  monthlySummary Boolean @default(true) @map("monthly_summary")

  largeTransaction          Boolean @default(true) @map("large_transaction")
  largeTransactionThreshold Decimal @default(1000) @map("large_transaction_threshold") @db.Decimal(12, 2)

  lowCash            Boolean @default(true) @map("low_cash")
  lowCashFloor       Decimal @default(0) @map("low_cash_floor") @db.Decimal(14, 2)
  lowCashHorizonDays Int     @default(30) @map("low_cash_horizon_days")

  invoiceReminders Boolean @default(true) @map("invoice_reminders")

  channelInApp Boolean @default(true) @map("channel_in_app")
  channelEmail Boolean @default(true) @map("channel_email")
  channelPush  Boolean @default(false) @map("channel_push")

  lastDailySentAt     DateTime? @map("last_daily_sent_at")
  lastWeeklySentAt    DateTime? @map("last_weekly_sent_at")
  lastMonthlySentAt   DateTime? @map("last_monthly_sent_at")
  lastLowCashAt       DateTime? @map("last_low_cash_at")
  lastInvoiceRemindAt DateTime? @map("last_invoice_remind_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// A browser Web Push subscription (VAPID). A user can have several
/// (one per browser/device); dead endpoints are pruned on send.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// An uploaded invoice/receipt document with extracted metadata.
model Invoice {
  id               String           @id @default(cuid())
  workspaceId      String           @map("workspace_id")
  /// The member who uploaded/created the invoice.
  userId           String           @map("user_id") @db.Uuid
  vendor           String           @default("")
  /// Where payment reminders for a receivable go. Null means this invoice has
  /// nobody to remind, which is what keeps it out of the dunning queue.
  customerEmail    String?          @map("customer_email")
  invoiceNumber    String?          @map("invoice_number")
  invoiceDate      DateTime?        @map("invoice_date")
  dueDate          DateTime?        @map("due_date")
  currency         String           @default("USD")
  subtotal         Decimal?         @db.Decimal(12, 2)
  vatAmount        Decimal?         @map("vat_amount") @db.Decimal(12, 2)
  /// VAT rate in percent (e.g. 21.00).
  vatRate          Decimal?         @map("vat_rate") @db.Decimal(5, 2)
  total            Decimal          @default(0) @db.Decimal(12, 2)
  direction        InvoiceDirection @default(PAYABLE)
  status           InvoiceStatus    @default(DRAFT)
  extractionStatus ExtractionStatus @default(NEEDS_REVIEW) @map("extraction_status")
  /// Telemetry: which provider/model extracted this document and how long it took.
  extractionProvider   String? @map("extraction_provider")
  extractionModel      String? @map("extraction_model")
  extractionDurationMs Int?    @map("extraction_duration_ms")
  /// Human-readable reason when extraction failed or needs review (shown in the UI).
  extractionReason     String? @map("extraction_reason")
  /// Arithmetic-mismatch warnings (string array) flagged during extraction.
  extractionWarnings   Json?   @map("extraction_warnings")
  /// Per-field confidence 0..1 reported by the model (highlights review fields).
  extractionConfidence Json?   @map("extraction_confidence")
  /// Object path in the private Supabase Storage bucket (userId/invoiceId/filename).
  storagePath      String           @map("storage_path")
  fileName         String           @map("file_name")
  mimeType         String           @map("mime_type")
  notes            String?
  /// Linked bank transaction; linking marks the invoice paid.
  transactionId    String?          @unique @map("transaction_id")
  /// Stable id of the source record for integration syncs, e.g.
  /// "xero:INV-123" — used to dedupe re-synced invoices.
  externalRef      String?          @map("external_ref")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile     Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  lineItems   InvoiceLineItem[]
  reminderLogs ReminderLog[]

  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, externalRef])
  @@map("invoices")
}

/// One payment reminder that actually reached a customer. Two jobs: it is the
/// audit trail ("what exactly did we send them, and when"), and it is the
/// escalation ladder's memory — the unique key below is what makes "each step
/// at most once per invoice" a fact of the database rather than a race the
/// cron might lose. Rows are written only for delivered mail, so an unsent
/// draft never burns a rung.
model ReminderLog {
  id        String      @id @default(cuid())
  invoiceId String      @map("invoice_id")
  kind      DunningStep
  toEmail   String      @map("to_email")
  subject   String
  body      String
  /// Who sent it. Null means the hourly cron did, with nobody in the loop.
  sentBy    String?     @map("sent_by") @db.Uuid
  sentAt    DateTime    @default(now()) @map("sent_at")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sender  Profile? @relation(fields: [sentBy], references: [id], onDelete: SetNull)

  @@unique([invoiceId, kind])
  @@index([invoiceId, sentAt(sort: Desc)])
  @@map("reminder_logs")
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)
  total       Decimal @default(0) @db.Decimal(12, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

/// A named set of assumptions to forecast against: "Base case", "Hire in Q4",
/// "Lose the top client". A scenario carries no numbers of its own — it groups
/// assumptions, and the forecast engine runs unchanged once per scenario.
///
/// Assumptions that predate scenarios keep `scenario_id = NULL`, which *is*
/// the base scenario rather than a row waiting to be backfilled. Nothing was
/// migrated, and a workspace that never names a scenario sees exactly what it
/// saw before.
model Scenario {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  /// The scenario the forecast page opens on. At most one per workspace is
  /// set; when none is, the page opens on the base (NULL) scenario.
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assumptions Assumption[]

  /// Two scenarios called "Base case" in one workspace would make the
  /// switcher a guessing game.
  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
  @@map("scenarios")
}

/// A user-defined adjustment applied on top of the data-driven cash forecast.
model Assumption {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  userId      String          @map("user_id") @db.Uuid
  /// Which named scenario this belongs to. NULL is the base scenario, which is
  /// where every assumption written before scenarios existed still lives.
  scenarioId  String?         @map("scenario_id")
  kind        AssumptionKind
  type      TransactionType
  label     String
  /// Amount for ONE_OFF and RECURRING assumptions.
  amount    Decimal?        @db.Decimal(12, 2)
  /// % per month for PERCENT_GROWTH assumptions.
  percent   Decimal?        @db.Decimal(6, 2)
  /// The date of a ONE_OFF assumption.
  date      DateTime?
  startDate DateTime?       @map("start_date")
  endDate   DateTime?       @map("end_date")
  enabled   Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Deleting a scenario deletes the assumptions written into it: they describe
  /// that one hypothesis and mean nothing detached from it.
  scenario  Scenario? @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([scenarioId])
  @@map("assumptions")
}

model Category {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  userId      String          @map("user_id") @db.Uuid
  name        String
  type        TransactionType
  color       String          @default("#6366f1")
  /// Seeded default categories; users can still rename/delete them.
  isDefault   Boolean         @default(false) @map("is_default")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile      Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  rules        CategoryRule[]
  budgets      Budget[]
  savingsGoals SavingsGoal[]

  @@unique([workspaceId, name])
  @@index([workspaceId, type])
  @@map("categories")
}

/// Auto-categorization rule: transactions whose description or counterparty
/// contains `pattern` (case-insensitive) get assigned `categoryId`.
model CategoryRule {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id") @db.Uuid
  pattern     String
  categoryId  String   @map("category_id")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, pattern])
  @@index([workspaceId])
  @@map("category_rules")
}

/// One CSV upload. Deleting a batch cascades to its transactions,
/// which is how an import gets undone.
model ImportBatch {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id") @db.Uuid
  fileName    String   @map("file_name")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile      Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("import_batches")
}

model Transaction {
  id            String          @id @default(cuid())
  workspaceId   String          @map("workspace_id")
  userId        String          @map("user_id") @db.Uuid
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  categoryId    String?         @map("category_id")
  description   String
  counterparty  String?
  date          DateTime
  /// Account balance after this transaction, when the bank statement provides it.
  balance       Decimal?        @db.Decimal(14, 2)
  /// Fingerprint of imported rows, used to skip duplicates across imports.
  hash          String?
  importBatchId String?         @map("import_batch_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile     Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  invoice     Invoice?

  @@unique([workspaceId, hash])
  @@index([workspaceId, date(sort: Desc)])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, importBatchId])
  @@map("transactions")
}

/// A spending cap for one category in one calendar month. A Personal-edition
/// surface (`/budgets`); Business workspaces do not expose it.
///
/// `category` holds the category NAME and is the uniqueness key, which works
/// because category names are unique per workspace (see Category). `categoryId`
/// is the resolved link, kept in sync by the app so spend can be summed by id
/// and so deleting a category takes its budgets with it.
model Budget {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id") @db.Uuid
  category    String
  categoryId  String?  @map("category_id")
  limit       Decimal  @db.Decimal(12, 2)
  month       Int
  year        Int
  /// Carry an underspend (or overspend) forward into the next month's
  /// available amount, instead of every month starting from `limit`.
  rollover    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile     Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryRef Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, category, month, year])
  @@index([workspaceId, year, month])
  @@map("budgets")
}

/// A named savings target ("Emergency fund", "Japan trip"). Progress comes
/// from explicit SavingsContribution rows plus `startingAmount`; a linked
/// category lets the app suggest contributions from real transactions, and a
/// linked bank account records where the money actually sits.
model SavingsGoal {
  id             String    @id @default(cuid())
  workspaceId    String    @map("workspace_id")
  userId         String    @map("user_id") @db.Uuid
  name           String
  targetAmount   Decimal   @map("target_amount") @db.Decimal(12, 2)
  /// When the user wants to get there. Null = no deadline, so the projection
  /// reports an expected date instead of an on-track/behind verdict.
  targetDate     DateTime? @map("target_date")
  /// Money already set aside before tracking started.
  startingAmount Decimal   @default(0) @map("starting_amount") @db.Decimal(12, 2)
  /// Optional: transactions in this category are treated as saving towards
  /// the goal, so contributions can be suggested rather than typed in.
  categoryId     String?   @map("category_id")
  /// Optional: the account holding the money.
  bankAccountId  String?   @map("bank_account_id")
  note           String?
  /// Set the first time the goal is fully funded.
  achievedAt     DateTime? @map("achieved_at")
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile       Profile               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bankAccount   BankAccount?          @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  contributions SavingsContribution[]

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("savings_goals")
}

/// One deposit towards a savings goal. Optionally points at the transaction
/// it was recognised from, which keeps a bank-fed contribution from being
/// counted twice.
model SavingsContribution {
  id            String   @id @default(cuid())
  goalId        String   @map("goal_id")
  amount        Decimal  @db.Decimal(12, 2)
  date          DateTime
  note          String?
  transactionId String?  @map("transaction_id")
  createdAt     DateTime @default(now()) @map("created_at")

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, transactionId])
  @@index([goalId, date(sort: Desc)])
  @@map("savings_contributions")
}

/// Something the workspace owns or owes that no bank connection reports: a
/// house, a car, an index fund, a mortgage. Bank balances already arrive
/// through BankAccount and are added to net worth from there, so an asset row
/// exists precisely for what is *not* synced — which is what keeps the two
/// from double-counting the same money.
///
/// The row itself holds no value. Worth changes over time and the history is
/// the interesting part, so every figure lives in AssetValuation and the
/// latest one is the current value.
model Asset {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id") @db.Uuid
  name        String
  kind        AssetKind
  /// Held in this currency. Null means the workspace currency. A holding in
  /// another currency is shown but never summed — there is no FX rate
  /// anywhere in this app and inventing one would misstate net worth.
  currency    String?
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile    Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  valuations AssetValuation[]

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("assets")
}

/// What an asset was worth on a date. Append-only: a correction is a new row,
/// not an edit, because the history is what draws the net-worth line and
/// rewriting it would quietly change the past. Liabilities are stored
/// positive and subtracted, so a value is never negative.
model AssetValuation {
  id        String   @id @default(cuid())
  assetId   String   @map("asset_id")
  value     Decimal  @db.Decimal(14, 2)
  /// The day the figure describes, not the day it was entered.
  asOf      DateTime @map("as_of")
  createdAt DateTime @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, asOf(sort: Desc)])
  @@map("asset_valuations")
}

/// A copilot conversation, shared across the workspace's members.
/// userId records who started it.
model Conversation {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id") @db.Uuid
  title       String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([workspaceId, updatedAt(sort: Desc)])
  @@map("conversations")
}

model ChatMessage {
  id             String   @id @default(cuid())
  userId         String   @map("user_id") @db.Uuid
  conversationId String   @map("conversation_id")
  role           ChatRole
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  profile      Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@map("chat_messages")
}

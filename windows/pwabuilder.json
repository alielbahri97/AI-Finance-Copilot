  "pwabuilder": {
    "windowsPackageOptions": {
      "packageId": "com.ballastmoney.app",
      "name": "Ballast",
      "publisher": {
        "displayName": "Ballast",
        "commonName": "CN=Ballast"
      },
      "version": "1.0.0.0",
      "url": "https://app.ballastmoney.com"

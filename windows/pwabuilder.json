  "start_url": "https://app.ballastmoney.com/dashboard",
  "scope": "https://app.ballastmoney.com/",
  "display": "standalone",
  "background_color": "#E9F3FF",
  "theme_color": "#005ADB",
  "icons": [
    {
      "src": "https://app.ballastmoney.com/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "https://app.ballastmoney.com/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "https://app.ballastmoney.com/icons/icon-512-maskable.png",
